# Copy this file to .env.local and adjust as needed
#
# Base URL of the backend API (see ../backend). Used both server-side
# (page data fetching, SEO metadata) and client-side (auth, favorites,
# forms) — NEXT_PUBLIC_ so it's available in the browser too.
NEXT_PUBLIC_API_BASE_URL=https://listings-api.brevardcoastalhomes.com

# Agent/business contact info shown on Property Detail, Contact Us, etc.
# Mirror these to match backend/.env's BUSINESS_NAME / BUSINESS_PHONE / BUSINESS_EMAIL.
NEXT_PUBLIC_AGENT_NAME=Ryan
NEXT_PUBLIC_BUSINESS_NAME=Brevard Coastal Homes
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
